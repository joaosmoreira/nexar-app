{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexar HUB",
  "version": "1.0.0",
  "identifier": "com.ctk.nexar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexar HUB",
        "width": 1920,
        "height": 1080,
        "fullscreen": false,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "upgradeCode": "B3F7A2D1-4E8C-4A1F-9C3B-2D5E6F7A8B9C"
      }
    }
  }
}
